<Window x:Class="LectorBoletasWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lector y Desglosador de Boletas - EDET y SAT" 
        Height="780" Width="1080"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilos Modernos -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="2" Direction="270" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="secBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="secBorder" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SampleButton" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#1E40AF"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Encabezado -->
            <RowDefinition Height="Auto"/>
            <!-- Entrada de Código de Barras -->
            <RowDefinition Height="Auto"/>
            <!-- Contenido Principal: Hero Card y Desglose -->
            <RowDefinition Height="*"/>
            <!-- Barra de Estado Inferior -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Margin="0,0,0,16" Background="#1E293B" CornerRadius="10" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Lector de Boletas" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <!-- Badges Empresas Soportadas -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ENTRADA DE CÓDIGO DE BARRAS -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila de Entrada Principal -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox x:Name="TxtBarcode" FontSize="16" FontFamily="Consolas, Segoe UI" 
                                 Padding="12,10" VerticalAlignment="Center"
                                 BorderBrush="#D1D5DB" BorderThickness="1.5"
                                 KeyDown="TxtBarcode_KeyDown"
                                 TextChanged="TxtBarcode_TextChanged"/>
                        <TextBlock x:Name="TxtPlaceholder" 
                                   Text="Escanee con pistola lectora o ingrese el código de barras aquí y presione Enter..." 
                                   Foreground="#9CA3AF" FontSize="14" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>

                    <Button Grid.Column="1" Content="🔍 Procesar Código" Style="{StaticResource ActionButton}" 
                            Margin="0,0,8,0" Click="BtnProcesar_Click"/>

                    <Button Grid.Column="2" Content="🧹 Limpiar" Style="{StaticResource SecondaryButton}" 
                            Click="BtnLimpiar_Click"/>
                </Grid>

                <!-- Fila de Ejemplos y Contador -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Longitud actual:" FontSize="12" Foreground="#6B7280" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtLongitud" Text="0 caracteres" FontSize="12" FontWeight="Bold" Foreground="#1F2937"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL: HERO CARD Y DESGLOSE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: HERO CARD Y RESUMEN -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelResumen" Orientation="Vertical">

                        <!-- Tarjeta de Estado / Empresa -->
                        <Border x:Name="BorderEmpresaBadge" CornerRadius="8" Padding="14,12" Margin="0,0,0,14" Background="#F3F4F6">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtEmpresaIcono" Text="📋" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="TxtEmpresaNombre" Text="Esperando Código..." FontSize="18" FontWeight="Bold" Foreground="#1F2937"/>
                                        <TextBlock x:Name="TxtEmpresaSubtitulo" Text="Ingrese un código de barras para comenzar" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Importe Destacado -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="IMPORTE A PAGAR" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtImportePrincipal" Text="$ 0,00" FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock x:Name="TxtSubtextoImporte" Text="Importe de 1° Vencimiento" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Fechas de Vencimiento -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,4,0">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="1° VENCIMIENTO" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                    <TextBlock x:Name="TxtFechaVto1" Text="-" FontSize="15" FontWeight="Bold" Foreground="#78350F" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4,0,0,0">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="2° VENCIMIENTO" FontSize="10" FontWeight="Bold" Foreground="#991B1B"/>
                                    <TextBlock x:Name="TxtFechaVto2" Text="-" FontSize="15" FontWeight="Bold" Foreground="#7F1D1D" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtImporteVto2" Text="" FontSize="11" Foreground="#991B1B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Identificador de Factura / Cliente -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="IDENTIFICACIÓN DE FACTURA / CUENTA" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtIdentificador" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Estado de Integridad / Dígito Verificador -->
                        <Border x:Name="BorderValidacion" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtValidacionIcono" Text="✓" FontSize="16" FontWeight="Bold" Foreground="#059669" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Vertical" Width="290">
                                    <TextBlock x:Name="TxtValidacionTitulo" Text="Control de Integridad" FontSize="12" FontWeight="Bold" Foreground="#065F46"/>
                                    <TextBlock x:Name="TxtValidacionMensaje" Text="Ingrese una boleta para validar." FontSize="11" Foreground="#047857" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Mensaje de Error (si ocurre) -->
                        <Border x:Name="BorderError" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtErrorMensaje" Text="Mensaje de error" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" Width="300"/>
                            </StackPanel>
                        </Border>

                        <!-- Botón de Copiar Resumen -->
                        <Button x:Name="BtnCopiarResumen" Content="📋 Copiar Resumen al Portapapeles" 
                                Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" 
                                Click="BtnCopiarResumen_Click" Visibility="Collapsed"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- PANEL DERECHO: DESGLOSE COMPLETO DE CAMPOS -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="Desglose Técnico de Datos del Código" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                            <TextBlock x:Name="TxtFormatoDetectado" Text="Estructura según especificación técnica" FontSize="12" Foreground="#6B7280"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCantidadCampos" Text="0 campos" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563"/>
                        </Border>
                    </Grid>

                    <!-- Tabla de Campos -->
                    <DataGrid x:Name="GridCampos" Grid.Row="1" AutoGenerateColumns="False" 
                              IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                              HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                              RowHeight="36" FontSize="13">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Campo -->
                            <DataGridTextColumn Header="Campo" Binding="{Binding Nombre}" Width="190">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1F2937"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Valor Interpretado -->
                            <DataGridTextColumn Header="Valor Interpretado" Binding="{Binding ValorInterpretado}" Width="190">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Valor Raw -->
                            <DataGridTextColumn Header="En Código (Raw)" Binding="{Binding ValorRaw}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Posición -->
                            <DataGridTextColumn Header="Posición" Binding="{Binding Posicion}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Descripción -->
                            <DataGridTextColumn Header="Descripción Técnica" Binding="{Binding Descripcion}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- BARRA DE ESTADO INFERIOR -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Text="Listo para escanear. Ingrese un código para comenzar." 
                           FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="Lector de Boletas v1.0 | C# .NET 9 WPF" 
                           FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
